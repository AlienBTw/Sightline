{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sightline/training/frame_labels.v1",
  "title": "Glimmer per-frame factor labels (v1)",
  "description": "Reference copy of what glimmer_schema.validate_frame_labels() enforces. F11 is not labeled by Glimmer.",
  "type": "object",
  "required": ["factors"],
  "properties": {
    "factors": {
      "type": "object",
      "required": ["F1", "F2", "F3", "F4", "F5", "F6", "F7", "F8", "F9", "F10"],
      "additionalProperties": false,
      "patternProperties": {
        "^F([1-9]|10)$": {
          "type": "object",
          "required": ["state", "confidence"],
          "properties": {
            "state": {"enum": ["present", "absent", "uncertain"]},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1},
            "evidence": {"type": "string", "maxLength": 200}
          }
        }
      }
    }
  }
}
