# Copy to .env and fill in. Never commit .env.

# Required: live | replay
# Offline demo without GPU: SIGHTLINE_MODE=replay and DETECTOR_BACKEND=replay
SIGHTLINE_MODE=live

# Streamlit → API (hosting-ready: point this at a remote API later)
API_URL=http://127.0.0.1:8000

# Exactly one detector backend: llmdet | owlv2 | rtdetr | dfine | replay
DETECTOR_BACKEND=llmdet

# Exactly one report backend: ollama | meta_api
#   ollama   = local Muse Glimmer 30B through Ollama (OpenAI-compatible)
#   meta_api = Muse Spark through the Meta Model API
REPORT_BACKEND=ollama

# Ollama (when REPORT_BACKEND=ollama). Base URL includes /v1.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=muse-glimmer:30b

# Meta Model API (when REPORT_BACKEND=meta_api). Take the base URL and model id from the Meta Model API docs.
META_API_BASE_URL=
META_API_KEY=
META_API_MODEL=

# Sparse VLM evidence gate: any OpenAI-compatible endpoint (base URL includes /v1).
# Leave VLM_BASE_URL empty to keep the gate off. Local example:
#   VLM_BASE_URL=http://localhost:11434/v1  VLM_MODEL=muse-glimmer:30b
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=

# Device: cuda | cpu
TORCH_DEVICE=cuda

# SQLite path
SIGHTLINE_DB=./data/sightline.db

# Sampling
SAMPLE_FPS=2

# ---- Live pipeline (sightline_pipeline/) ----
# Meta Model API key for escalations (SAM 3.1 refine + Muse Spark verdict). META_API_KEY is accepted as an alias.
# Base URL defaults to https://api.meta.ai/v1 (META_API_BASE_URL above overrides it when set).
MODEL_API_KEY=
# SAM 3.1 backend: api (Meta Model API, model SAM_MODEL) | local (open weights, gated facebook/sam3.1 + `sam3` package) | off
SAM_BACKEND=api
SAM_MODEL=sam-3.1
SAM3_CHECKPOINT=
# Muse Spark verdict backend: api | off
MUSE_BACKEND=api
MUSE_SPARK_MODEL=muse-spark-1.3
# Turn all escalation off (0/off) without touching the config file
SIGHTLINE_ESCALATION=on
# Optional overrides of sightline_pipeline/config.yaml
SIGHTLINE_DEVICE=cuda:0
SIGHTLINE_DATA_DIR=data/live
SIGHTLINE_HEAD_CHECKPOINT=
SIGHTLINE_ENCODER_WEIGHTS=
SIGHTLINE_VJEPA_REPO=

# ---- Backend API (backend/) ----
# Generate with: ~/vjepa-venv/bin/python -m backend.hash_password --secret | --generate | --admin
SIGHTLINE_JWT_SECRET=
# Judge login (role demo: read + upload + start/stop uploaded cameras + ack/dismiss)
SIGHTLINE_DEMO_USER=
SIGHTLINE_DEMO_PASSWORD_HASH=
# Your own login (role admin: also RTSP cameras, edit, delete)
SIGHTLINE_ADMIN_USER=
SIGHTLINE_ADMIN_PASSWORD_HASH=
# Token lifetimes (seconds): access, refresh, signed media links
SIGHTLINE_ACCESS_TTL_S=900
SIGHTLINE_REFRESH_TTL_S=604800
SIGHTLINE_MEDIA_TTL_S=900
# GPUs for camera workers and the cap per GPU (about 3 cameras per RTX 3090 at 1 step/s)
SIGHTLINE_GPUS=cuda:0,cuda:1
SIGHTLINE_CAMERAS_PER_GPU=3
# Uploads -> virtual cameras
SIGHTLINE_UPLOAD_MAX_MB=300
SIGHTLINE_UPLOAD_MAX_SECONDS=600
SIGHTLINE_UPLOADS_PER_HOUR=12
SIGHTLINE_MAX_VIRTUAL_CAMERAS=30
SIGHTLINE_UPLOAD_MAX_RUNTIME_S=1800
SIGHTLINE_UPLOAD_DIR=data/uploads
SIGHTLINE_BACKEND_DIR=data/backend
SIGHTLINE_SEED_DEMO_CAMERA=1
SIGHTLINE_DEMO_VIDEO=data/demo/sightline_demo.mp4
SIGHTLINE_AUTOSTART=1
# Expo push (no key needed for basic use; set only if Expo "enhanced push security" is on)
SIGHTLINE_PUSH=on
EXPO_ACCESS_TOKEN=
SIGHTLINE_PUSH_COOLDOWN_S=60
# Web origins allowed by CORS (the native app and the same-origin dev console need none)
SIGHTLINE_CORS_ORIGINS=
# Optional Host-header allowlist, e.g. localhost,127.0.0.1,<name>.ngrok-free.app
SIGHTLINE_ALLOWED_HOSTS=
SIGHTLINE_TRUST_PROXY=1
SIGHTLINE_LOGIN_PER_MINUTE=5
SIGHTLINE_API_PER_MINUTE=600
SIGHTLINE_MJPEG_MAX_SECONDS=300
SIGHTLINE_PREVIEW_QUALITY=60
SIGHTLINE_API_DOCS=0
# ngrok: keep the authtoken in ngrok's own config (ngrok config add-authtoken) or NGROK_AUTHTOKEN in your
# Windows user environment, never here. Optional pinned URL for backend/scripts/start_ngrok.ps1:
SIGHTLINE_NGROK_URL=
